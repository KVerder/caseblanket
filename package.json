{
  "name": "caseblanket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Designs a minimum-thickness, minimum-volume PC case around a component list, with an interactive touch-friendly 3D preview.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:artifact": "tsc -p . && vite build --mode artifact --outDir dist-artifact",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "e2e": "node e2e/run.mjs e2e/out",
    "build:single": "tsc -p . && vite build --mode single --outDir dist-single && node scripts/single-html.mjs dist-single"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
